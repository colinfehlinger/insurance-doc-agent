# Copy to .env (gitignored) and fill in real values. Nothing here is committed.

# The verified SES identity used as BOTH the escalation/ops recipient and the
# send_reminder sender in dev. Kept out of the repo because in dev it is a real
# personal address -- same class as aws-targets.json and cdk.context.json.
#
# SES requires the sender identity (address, or its domain) to be verified
# before it can send at all. If this is unset, config.ts falls back to a
# reserved-for-documentation address so a misconfigured deploy fails loudly at
# SES rather than quietly emailing someone real.
IDA_SES_IDENTITY=you@example.com

# The 12-digit account the agent is deployed in. Scripts assert against this and
# refuse to run if the shell's credentials resolve elsewhere -- the guard that
# closed the cross-account ghost-read class (docs/step-6-agent-design.md).
EXPECTED_ACCOUNT=000000000000
