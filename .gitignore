# Dependencies
node_modules/

# CDK
cdk.out/
# Ignored because this repo is public and cached context holds account ids / AZs.
# No fromLookup calls exist yet. Revisit in the IDP step if that changes -- see README.
cdk.context.json
*.d.ts
*.js
!jest.config.js

# TypeScript build info
*.tsbuildinfo

# Environment / credentials -- never commit an account id, profile, or key
.env
.env.*
!.env.example

# AgentCore deployment targets. The AwsDeploymentTarget schema requires a literal
# 12-digit account id (^[0-9]{12}$) -- it accepts no token or env-var indirection,
# unlike infra/ which resolves the account from CDK_DEFAULT_ACCOUNT at synth time.
# This repo is public, so the real file stays out; aws-targets.example.json is the
# tracked template. Globbed rather than path-pinned so it survives a project rename.
agent/**/aws-targets.json
!agent/**/aws-targets.example.json

# AgentCore CLI deployed state. This OVERRIDES the generated
# agent/**/agentcore/.gitignore, which force-commits the file via an explicit
# negation (`!.cli/deployed-state.json`) so teams can share deployed ARNs.
# We do not want that here: after `agentcore deploy` the file holds runtime and
# IAM role ARNs that embed the 12-digit account id -- the same leak class as
# aws-targets.json, just deferred until the first successful deploy.
# It is local state and is regenerated by deploy, so nothing is lost.
#
# NOTE: this must exclude the DIRECTORY, not the file. A deeper .gitignore takes
# precedence over a parent one, so a file-level rule here loses to the generated
# `!.cli/deployed-state.json`. Excluding the directory wins because git will not
# descend into an excluded directory, and a file under one cannot be re-included.
agent/**/.cli/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Local scratch
tmp/
*.log
