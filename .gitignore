# Dependencies
node_modules/

# CDK
cdk.out/
# Ignored because this repo is public and cached context holds account ids / AZs.
# No fromLookup calls exist yet. Revisit in the IDP step if that changes -- see README.
cdk.context.json
*.d.ts
*.js
!jest.config.js

# TypeScript build info
*.tsbuildinfo

# Environment / credentials -- never commit an account id, profile, or key
.env
.env.*
!.env.example

# AgentCore deployment targets. The AwsDeploymentTarget schema requires a literal
# 12-digit account id (^[0-9]{12}$) -- it accepts no token or env-var indirection,
# unlike infra/ which resolves the account from CDK_DEFAULT_ACCOUNT at synth time.
# This repo is public, so the real file stays out; aws-targets.example.json is the
# tracked template. Globbed rather than path-pinned so it survives a project rename.
agent/**/aws-targets.json
!agent/**/aws-targets.example.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Local scratch
tmp/
*.log
